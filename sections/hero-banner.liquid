<div class="relative h-[85vh] w-full overflow-hidden">
  <img src="{{ section.settings.image | image_url: width: 1600 }}" 
       alt="{{ section.settings.heading }}" 
       class="absolute inset-0 h-full w-full object-cover opacity-90">
  <div class="absolute inset-0 bg-lumiere-charcoal/30"></div>
  
  <div class="relative z-10 flex h-full flex-col items-center justify-center text-center px-4">
    <h1 class="font-serif text-5xl md:text-7xl text-white mb-6 tracking-wide animate-fade-in-up">
      {{ section.settings.heading }}
    </h1>
    <p class="font-sans text-lg md:text-xl text-lumiere-cream/90 mb-8 max-w-2xl font-light">
      {{ section.settings.subheading }}
    </p>
    <a href="{{ section.settings.button_link }}" 
       class="bg-lumiere-gold text-white px-8 py-4 font-sans text-sm tracking-widest uppercase hover:bg-white hover:text-lumiere-charcoal transition-all duration-300">
      {{ section.settings.button_text }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate Your Ambiance" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Explore the Collection" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}